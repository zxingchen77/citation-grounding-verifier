# Export these in your shell; this file is not loaded automatically.
VERIFIER_METHOD=optimized
LLM_BACKEND=http
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-your-structured-output-model
LLM_API_KEY=replace-locally-never-commit
LLM_TIMEOUT_SECONDS=30
VERIFIER_TIMEOUT_SECONDS=120
# For local evaluation with an existing ChatGPT/Codex login:
# LLM_BACKEND=codex
# LLM_MODEL=gpt-6-astra
# LLM_TIMEOUT_SECONDS=90
# VERIFIER_TIMEOUT_SECONDS=240
# Set only if the selected model supports temperature.
# LLM_TEMPERATURE=0
# Optional verified prices per million tokens (USD), used for estimates only.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
